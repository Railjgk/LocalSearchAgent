# LocalSearchAgent local environment variables.
# Keep this file local. It is already ignored by .gitignore.
#
# Load in shell:
#   set -a && source .env && set +a
#
# Or run one command:
#   set -a && source .env && set +a && python run.py "浠婃櫄鍜屾湅鍙嬪悆鐏攨锛?涓汉锛岄绠?00"


# ---------------------------------------------------------------------------
# A-stage LLM intent parser
# ---------------------------------------------------------------------------
# Enable A-stage LLM intent parsing. When disabled or unavailable, A falls back
# to the deterministic rule parser.
WF_A_LLM_ENABLED=1

# A-specific key takes priority. If left empty, A can reuse LONGCAT_API_KEY.
WF_A_LLM_API_KEY
WF_A_LLM_APP_KEY

WF_A_LLM_BASE_URL=https://api.longcat.chat/openai
WF_A_LLM_MODEL=LongCat-2.0-Preview
WF_A_LLM_TIMEOUT_SECONDS=30
WF_A_LLM_MAX_TOKENS=1200
WF_A_LLM_TEMPERATURE=0.2


# ---------------------------------------------------------------------------
# B-stage LLM semantic hints and explanation
# ---------------------------------------------------------------------------
# Enable B-stage LongCat enhancements. Default code path is deterministic when
# this is 0 or the key is missing.
WF_B_AI_ENABLED=1

# Empty means semantic hints follow WF_B_AI_ENABLED. Set 0/1 to override.
WF_B_AI_SEMANTIC_HINTS_ENABLED=1

# Shared LongCat/OpenAI-compatible config used by B and experiments. A also
# uses these when WF_A_LLM_API_KEY/WF_A_LLM_APP_KEY are empty.
LONGCAT_API_KEY
LONGCAT_APP_KEY
LONGCAT_BASE_URL=https://api.longcat.chat/openai
LONGCAT_MODEL=LongCat-2.0-Preview
LONGCAT_TIMEOUT_SECONDS=30
LONGCAT_MAX_TOKENS=1200
LONGCAT_TEMPERATURE=0.2


# ---------------------------------------------------------------------------
# Gaode/Amap APIs for weather, route, optional POI lookup, and supply building
# ---------------------------------------------------------------------------
GAODE_API_KEY

# Optional weather-specific override. Empty falls back to GAODE_API_KEY.
GAODE_WEATHER_API_KEY


# ---------------------------------------------------------------------------
# WeekendFlow data, routing, memory, and policy knobs
# ---------------------------------------------------------------------------
# Candidate sources. Current default is local fixtures plus C mock API.
WF_DATA_SOURCE_ORDER=local_supply_mock,c_mock_api

# Local supply/mock data directory.
WF_MOCK_DATA_DIR=experiments/mock_data

# Planner policy path.
WF_PLANNER_POLICY_PATH=experiments/planner_policy.yaml

# Route source priority used by B candidate generation.
WF_ROUTE_SOURCE_ORDER=offline_routes_json,coordinate_estimate,poi_distance_fallback

# Optional memory store path. Empty uses the built-in/default memory behavior.
WF_MEMORY_STORE_PATH=
GAODE_API_KEY=自己的key
GAODE_WEATHER_API_KEY=自己的key
WF_A_LLM_API_KEY=自己的key
WF_A_LLM_APP_KEY=自己的key
LONGCAT_API_KEY=自己的key
LONGCAT_APP_KEY=自己的key
